{
   "update_url": "https://clients2.google.com/service/update2/crx",
   "manifest_version": 3,
   "name": "SaveGram",
   "description": "SaveGram \u2014 Fast, high-resolution downloader for Instagram photos, videos, carousels, Stories, and Reels.",
   "version": "1.1.0",
   "icons": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/igdl2-128.png",
      "512": "icons/igdl2.png"
   },
   "web_accessible_resources": [
      {
         "resources": [
            "icons/download_all_black.svg",
            "icons/download_all_white.svg",
            "icons/download_black.svg",
            "icons/download_white.svg",
            "icons/close_black_24dp.svg",
            "icons/igdl2.png",
            "icons/igdl2-128.png",
            "icons/savegram.svg"
         ],
         "matches": [
            "*://*/*"
         ]
      },
      {
         "resources": [
            "js/options.js",
            "css/options.css"
         ],
         "matches": [
            "*://*.instagram.com/*"
         ]
      }
   ],
   "options_page": "options.html",
   "permissions": [
      "storage"
   ],
   "host_permissions": [
      "*://*.instagram.com/*",
      "*://*.cdninstagram.com/*",
      "*://*.cdninstagram.net/*",
      "*://*.fbcdn.net/*"
   ],
   "background": {
      "service_worker": "js/background.js"
   },
   "content_scripts": [
      {
         "matches": [
            "*://*.instagram.com/*"
         ],
         "js": [
            "js/extension.js"
         ],
         "css": [
            "css/extension.css"
         ]
      },
      {
         "matches": [
            "*://*.instagram.com/*"
         ],
         "js": [
            "js/inject.js"
         ],
         "run_at": "document_start",
         "world": "MAIN"
      },
      {
         "matches": [
            "*://*.instagram.com/*"
         ],
         "js": [
            "js/options_listener_inject.js"
         ],
         "run_at": "document_start"
      }
   ],
   "action": {
      "default_title": "SaveGram",
      "default_icon": {
         "16": "icons/icon-16.png",
         "32": "icons/icon-32.png",
         "48": "icons/icon-48.png",
         "128": "icons/igdl2-128.png"
      }
   }
}
