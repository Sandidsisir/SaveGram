{
   "update_url": "https://clients2.google.com/service/update2/crx",
   "manifest_version": 3,
   "name": "SaveGram",
   "author": "sandid",
   "version": "1.2.0",
   "version_name": "1.2.0",
   "default_locale": "en",
   "description": "A browser extension for saving Instagram media directly to your computer with built-in video controls.",
   "icons": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/igdl2-128.png",
      "512": "icons/igdl2.png"
   },
   "web_accessible_resources": [
      {
         "resources": [
            "icons/download_all_black.svg",
            "icons/download_all_white.svg",
            "icons/download_black.svg",
            "icons/download_white.svg",
            "icons/close_black_24dp.svg",
            "icons/igdl2.png",
            "icons/igdl2-128.png",
            "icons/savegram.svg",
            "icons.svg",
            "favicon.svg"
         ],
         "matches": [
            "*://*/*"
         ]
      },
      {
         "resources": [
            "js/options.js",
            "css/options.css",
            "assets/i18n-DuqvkEc6.js",
            "assets/instagram-video-controls.ts-DTwx--3R.js"
         ],
         "matches": [
            "*://*.instagram.com/*"
         ],
         "use_dynamic_url": false
      }
   ],
   "options_page": "options.html",
   "permissions": [
      "storage"
   ],
   "host_permissions": [
      "*://*.instagram.com/*",
      "*://*.cdninstagram.com/*",
      "*://*.cdninstagram.net/*",
      "*://*.fbcdn.net/*"
   ],
   "background": {
      "service_worker": "js/background.js"
   },
   "content_scripts": [
      {
         "matches": [
            "*://*.instagram.com/*"
         ],
         "js": [
            "js/extension.js"
         ],
         "css": [
            "css/extension.css"
         ]
      },
      {
         "matches": [
            "*://*.instagram.com/*"
         ],
         "js": [
            "js/inject.js"
         ],
         "run_at": "document_start",
         "world": "MAIN"
      },
      {
         "matches": [
            "*://*.instagram.com/*"
         ],
         "js": [
            "js/options_listener_inject.js"
         ],
         "run_at": "document_start"
      },
      {
         "matches": [
            "*://*.instagram.com/*"
         ],
         "js": [
            "assets/instagram-video-controls.ts-loader-CWjG9L7w.js"
         ],
         "css": [
            "src/content/instagram-video-controls.css"
         ],
         "run_at": "document_idle"
      }
   ],
   "action": {
      "default_title": "SaveGram",
      "default_popup": "src/popup/popup.html",
      "default_icon": {
         "16": "icons/icon-16.png",
         "32": "icons/icon-32.png",
         "48": "icons/icon-48.png",
         "128": "icons/igdl2-128.png"
      }
   }
}
